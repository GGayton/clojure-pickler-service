{
  "name": "clojure-pickler-service",
  "version": "1.0.0",
  "description": "",
  "license": "MIT",
  "author": "George Gayton",
  "type": "module",
  "main": "./dist/index.cjs",
  "exports": {
    ".": {
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      },
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      }
    }
  },
  "types": "./dist/index.d.ts",
  "files": [
    "dist/index.js",
    "dist/index.cjs",
    "dist/index.d.ts",
    "dist/index.d.cts"
  ],
  "scripts": {
    "build": "tsdown",
    "build:clean": "npm run clean && npm run build",
    "changelog": "commit-and-tag-version",
    "clean": "rm -rf ./dist",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "pack": "npm pack",
    "pack:clean": "rm -rf *.tgz && npm run pack",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.3.12",
    "@types/node": "^24.10.4",
    "@typescript-eslint/eslint-plugin": "^8.46.3",
    "@typescript-eslint/parser": "^8.46.3",
    "nodemon": "^3.1.10",
    "pino": "^10.3.0",
    "pino-pretty": "^13.1.3",
    "tree-sitter-cli": "^0.25.10",
    "ts-node": "^10.9.2",
    "tsdown": "^0.20.1",
    "vitest": "^4.0.18"
  },
  "dependencies": {
    "@cucumber/gherkin": "^37.0.0",
    "@cucumber/messages": "^31.0.1",
    "node-addon-api": "^8.5.0",
    "node-gyp-build": "^4.8.4",
    "tree-sitter-clojure-orchard": "^0.2.5"
  },
  "peerDependencies": {
    "tree-sitter": "^0.25.0"
  }
}
